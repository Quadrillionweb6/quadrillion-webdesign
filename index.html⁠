<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Quadrillion Web & Creative Design | Digital Software & Visual Branding</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-950 text-gray-100 font-sans antialiased selection:bg-blue-600 selection:text-white">

  <!-- Navigation -->
  <header class="sticky top-0 z-50 bg-gray-950/80 backdrop-blur-md border-b border-gray-800/80">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="#" class="text-xl font-extrabold tracking-wider text-blue-500 hover:text-blue-400 transition">
        QUADRILLION
      </a>
      <nav class="hidden md:flex space-x-8 text-sm font-medium text-gray-300">
        <a href="#services" class="hover:text-blue-400 transition">Services</a>
        <a href="#portfolio" class="hover:text-blue-400 transition">Portfolio</a>
        <a href="#about" class="hover:text-blue-400 transition">About</a>
        <a href="#contact" class="hover:text-blue-400 transition">Contact</a>
      </nav>
      <a href="#contact" class="bg-blue-600 hover:bg-blue-500 text-white text-xs md:text-sm font-semibold px-4 py-2 rounded-lg shadow-md transition">
        Get Started
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="max-w-5xl mx-auto text-center py-24 px-6">
    <span class="inline-block px-3 py-1 text-xs font-semibold tracking-wide text-blue-400 bg-blue-950/60 border border-blue-800/50 rounded-full mb-6">
      Digital Software Engineering & Visual Identity
    </span>
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">
      We Build Scalable Software & <br class="hidden md:inline"/> High-Impact Brand Experiences
    </h1>
    <p class="text-base md:text-lg text-gray-400 mb-8 max-w-2xl mx-auto leading-relaxed">
      From full-stack web applications and custom database architectures to striking corporate brand identity and graphic design.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#portfolio" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-500 text-white font-semibold px-6 py-3 rounded-lg shadow-lg transition">
        View Work
      </a>
      <a href="#services" class="w-full sm:w-auto bg-gray-900 hover:bg-gray-800 text-gray-200 border border-gray-800 font-semibold px-6 py-3 rounded-lg transition">
        Our Services
      </a>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="py-20 border-t border-gray-900 bg-gray-950/50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white tracking-tight">Core Expertise</h2>
        <p class="text-gray-400 mt-2 text-sm md:text-base">Tailored technical and creative solutions engineered for growth.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Service 1 -->
        <div class="bg-gray-900/60 p-8 rounded-2xl border border-gray-800/80 hover:border-blue-500/50 transition">
          <div class="w-12 h-12 bg-blue-900/40 text-blue-400 rounded-xl flex items-center justify-center font-bold text-xl mb-6">
            &lt;/&gt;
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Full-Stack Development</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Modern web applications built with React, Next.js, Node.js, and robust database architectures powered by Supabase and MongoDB.
          </p>
        </div>

        <!-- Service 2 -->
        <div class="bg-gray-900/60 p-8 rounded-2xl border border-gray-800/80 hover:border-blue-500/50 transition">
          <div class="w-12 h-12 bg-blue-900/40 text-blue-400 rounded-xl flex items-center justify-center font-bold text-xl mb-6">
            🎨
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Brand Identity & Design</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            Corporate logos, high-conversion visual marketing assets, promotional graphics, and cohesive apparel mockups.
          </p>
        </div>

        <!-- Service 3 -->
        <div class="bg-gray-900/60 p-8 rounded-2xl border border-gray-800/80 hover:border-blue-500/50 transition">
          <div class="w-12 h-12 bg-blue-900/40 text-blue-400 rounded-xl flex items-center justify-center font-bold text-xl mb-6">
            ⚡
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Technical Direction</h3>
          <p class="text-gray-400 text-sm leading-relaxed">
            End-to-end management of digital campaigns, creative lock-in initiatives, and brand positioning strategies.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio Section -->
  <section id="portfolio" class="py-20 border-t border-gray-900">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-white tracking-tight">Featured Work</h2>
        <p class="text-gray-400 mt-2 text-sm md:text-base">A glimpse into recent engineering and design projects.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Project 1 -->
        <div class="bg-gray-900/40 rounded-2xl border border-gray-800 overflow-hidden group">
          <div class="p-8">
            <span class="text-xs font-semibold text-blue-400 uppercase tracking-widest">Web Application</span>
            <h3 class="text-2xl font-bold text-white mt-2 mb-3">Fashion Fusion Web App</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">
              A full-stack digital web platform engineered for seamless product showcases, interactive design visualizers, and user engagement.
            </p>
            <div class="flex flex-wrap gap-2 text-xs font-mono text-gray-300">
              <span class="bg-gray-800 px-3 py-1 rounded-md">React</span>
              <span class="bg-gray-800 px-3 py-1 rounded-md">Next.js</span>
              <span class="bg-gray-800 px-3 py-1 rounded-md">Node.js</span>
              <span class="bg-gray-800 px-3 py-1 rounded-md">MongoDB</span>
            </div>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="bg-gray-900/40 rounded-2xl border border-gray-800 overflow-hidden group">
          <div class="p-8">
            <span class="text-xs font-semibold text-blue-400 uppercase tracking-widest">Apparel & Visual Design</span>
            <h3 class="text-2xl font-bold text-white mt-2 mb-3">QJGS Streetwear Identity</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">
              End-to-end visual identity and graphic design collection for premium streetwear apparel, including custom logo mockups and apparel concepts.
            </p>
            <div class="flex flex-wrap gap-2 text-xs font-mono text-gray-300">
              <span class="bg-gray-800 px-3 py-1 rounded-md">Brand Strategy</span>
              <span class="bg-gray-800 px-3 py-1 rounded-md">Apparel Design</span>
              <span class="bg-gray-800 px-3 py-1 rounded-md">Visual Identity</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact / Call to Action -->
  <section id="contact" class="py-20 border-t border-gray-900 bg-gray-950/50">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4">Ready to build something exceptional?</h2>
      <p class="text-gray-400 mb-8 max-w-xl mx-auto">
        Whether you need a full-stack platform, backend API integration, or corporate brand identity, let's collaborate.
      </p>
      <a href="mailto:contact@quadrillionwebdesign.com" class="inline-block bg-blue-600 hover:bg-blue-500 text-white font-semibold px-8 py-4 rounded-xl shadow-xl transition">
        Start a Project
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-gray-900 py-8 text-center text-xs text-gray-500">
    <p>© 2026 Quadrillion Web & Creative Design Limited. All rights reserved.</p>
  </footer>

</body>
</html>
